{
  "entities": {
    "Confession": {
      "title": "Confession",
      "description": "A confession post in the corner.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" }
      },
      "required": ["username", "content", "timestamp", "likes", "likedBy"]
    },
    "ConfessionReply": {
      "title": "Confession Reply",
      "description": "A reply to a confession.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" }
      },
      "required": ["username", "content", "timestamp", "likes", "likedBy"]
    },
    "CharacterFeedback": {
      "title": "Character Feedback",
      "description": "Feedback for a character.",
      "type": "object",
      "properties": {
        "charId": { "type": "string" },
        "username": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" }
      },
      "required": ["charId", "username", "rating", "content", "timestamp", "likes", "likedBy"]
    },
    "BirthdayWish": {
      "title": "Birthday Wish",
      "description": "Birthday wishes for a character.",
      "type": "object",
      "properties": {
        "charId": { "type": "string" },
        "username": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" }
      },
      "required": ["charId", "username", "content", "timestamp", "likes", "likedBy"]
    },
    "SiteStats": {
      "title": "Site Stats",
      "description": "Global statistics for the website such as visitor count.",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" }
      },
      "required": ["totalVisits"]
    },
    "CharacterLike": {
      "title": "Character Like",
      "description": "Like records and user list for each character.",
      "type": "object",
      "properties": {
        "charId": { "type": "string" },
        "totalLikes": { "type": "number" },
        "likedBy": { "type": "array" },
        "lastUpdated": { "type": "timestamp" }
      },
      "required": ["charId", "totalLikes", "likedBy"]
    },
    "TamMenhDraw": {
      "title": "Tam Menh Draw",
      "description": "Stores user streak and draw statistics for Tam Menh Card game.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastDrawDate": { "type": "string" },
        "lastStreakDate": { "type": "string" },
        "lastCardId": { "type": "string" },
        "lastCharId": { "type": "string" },
        "totalDraws": { "type": "number" },
        "streak": { "type": "number" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["totalDraws", "streak"]
    },
    "MemoryLeaderboardEntry": {
      "title": "Memory Game Leaderboard Entry",
      "description": "Records player score for Top 5 Memory Game leaderboard.",
      "type": "object",
      "properties": {
        "playerName": { "type": "string" },
        "timeSec": { "type": "number" },
        "moves": { "type": "number" },
        "playedAt": { "type": "timestamp" }
      },
      "required": ["playerName", "timeSec", "moves"]
    },
    "ChatIdea": {
      "title": "Chat Idea",
      "description": "A community roleplay prompt or chat idea for characters.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["content", "likes", "likedBy"]
    }
  },
  "firestore": {
    "/chat_ideas/{ideaId}": {
      "schema": { "$ref": "#/entities/ChatIdea" },
      "description": "Stores user shared roleplay chat ideas with likes and real-time ranking"
    },
    "/memory_leaderboard/{entryId}": {
      "schema": { "$ref": "#/entities/MemoryLeaderboardEntry" },
      "description": "Stores top leaderboard scores for memory card game"
    },
    "/taminh_draws/{userId}": {
      "schema": { "$ref": "#/entities/TamMenhDraw" },
      "description": "Stores streak and draw history for Tam Menh card game per user"
    },
    "/character_likes/{charId}": {
      "schema": { "$ref": "#/entities/CharacterLike" },
      "description": "Stores like counts and liked users per character"
    },
    "/confessions/{confessionId}": {
      "schema": { "$ref": "#/entities/Confession" },
      "description": "Stores confession posts"
    },
    "/confessions/{confessionId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/ConfessionReply" },
      "description": "Stores replies to a specific confession"
    },
    "/char_feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/CharacterFeedback" },
      "description": "Stores character feedbacks"
    },
    "/birthday_wishes/{wishId}": {
      "schema": { "$ref": "#/entities/BirthdayWish" },
      "description": "Stores birthday wishes for characters"
    },
    "/site_stats/{statId}": {
      "schema": { "$ref": "#/entities/SiteStats" },
      "description": "Stores site stats like visitor counts"
    }
  }
}
